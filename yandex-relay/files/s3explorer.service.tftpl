[Unit]
Description=s3explorer
After=network-online.target
Wants=network-online.target

[Service]
# 3000 is taken by the rewriter on this box.
Environment="PORT=${port}"
Environment="NODE_ENV=production"
Environment="DATA_DIR=${data_dir}"
# APP_PASSWORD and SESSION_SECRET live in this file, not in the unit, so they stay
# out of Terraform state and out of `systemctl show`.
EnvironmentFile=/etc/s3explorer.env
WorkingDirectory=${app_dir}/apps/server
ExecStart=/usr/bin/node ${app_dir}/apps/server/dist/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
