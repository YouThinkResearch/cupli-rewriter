{
  email ${acme_email}

  # >>>CACHE  (stripped by apply.sh if the running caddy lacks the module)
  # souin (caddyserver/cache-handler). Defaults are deliberately conservative:
  # only what upstream marks cacheable is stored, and the rewriter now sets
  # Cache-Control on static assets so those are what actually land here.
  cache {
    ttl ${cache_ttl}
    stale ${cache_stale}
    default_cache_control no-store
  }
  # <<<CACHE
}

${caddy_hosts} {
  # stdout, not a file: the packaged unit sandboxes /var/log and Caddy refuses to
  # start when it cannot open the log, which turned a cosmetic setting into an outage.
  log {
    output stdout
    format json
  }

  cache # CACHE-LINE

  reverse_proxy 127.0.0.1:3000 {
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-Host {host}
  }
}

${explorer_host} {
  log {
    output stdout
    format json
  }

  # No `cache` here: this is an authenticated dynamic app, not static assets.
  reverse_proxy 127.0.0.1:${explorer_port}
}

# --- Services moved off EdgeCenter (lost 2026-11-05), all proxying to hetzner origins.
# They answer only on the second floating IP (31.129.59.118 -> 192.168.60.200); u-survey
# keeps 87.228.17.105. A per-site `bind` cannot coexist with the shared *:443 listener,
# and swapping that listener needs a Caddy restart (= u-survey outage), so the split is
# enforced on the local address instead. No `cache`: souin is unbounded and shares the
# 900M cap with the u-survey proxy.
(services_ip_only) {
  @not_services_ip not expression `{http.request.local.host} == "192.168.60.200"`
  abort @not_services_ip

  log {
    output stdout
    format json
  }
}

# SNI stays origin.youthink.io and Traefik routes on the Host header. Do NOT set SNI per
# request ({host}): the five names share one pooled HTTP/2 connection, Traefik routes it by
# the SNI it was opened with, and tracker/backend requests landed on the frontend
# (2026-11-05: CORS preflights to tracker failed, panel session events stopped).
youthink.io, www.youthink.io, backend.youthink.io, router.youthink.io, tracker.youthink.io {
  import services_ip_only
  reverse_proxy https://origin.youthink.io {
    # Caddy rewrites Host to the upstream name for https upstreams; keep the public one.
    header_up Host {host}
  }
}

# The origin nginx rejects requests without the relay secret (apps/oprosio/web.yaml).
# OPROS_RELAY_SECRET comes from caddy.service.d/opros-relay-secret.conf on the box.
opros.io, www.opros.io {
  import services_ip_only
  reverse_proxy https://origin.opros.io {
    header_up Host opros.io
    header_up x-relay-secret-key {$OPROS_RELAY_SECRET}
  }
}

# The istio gateway only trusts X-Forwarded-For when this header matches its EnvoyFilter
# (istio-system/ingress-trusted-xff), which is what antifraud keys the client IP on.
hub.ru.youthink.io {
  import services_ip_only
  reverse_proxy https://hub.youthink.io {
    header_up Host hub.youthink.io
    # Rotated 2026-11-05; HUB_RELAY_SECRET comes from caddy.service.d/hub-relay-secret.conf.
    header_up x-relay-secret-key {$HUB_RELAY_SECRET}
  }
}

sentry.ru.youthink.io {
  import services_ip_only
  reverse_proxy https://sentry.youthink.dev {
    header_up Host sentry.youthink.dev
  }
}
